# Copy this file to .env (same folder) and fill it in. .env stays on your Mac; git ignores it.

# The relay's admin key: the ADMIN_API_KEY secret you set with `npx wrangler secret put ADMIN_API_KEY` in relay/.
KISSA_ADMIN_KEY=

# From https://platform.claude.com/settings/keys (or leave empty after `ant auth login`).
ANTHROPIC_API_KEY=

# Optional
# KISSA_MODEL=claude-opus-5-5
# KISSA_RELAY_URL=https://kissa-relay.abpro.workers.dev
# PORT=4747
